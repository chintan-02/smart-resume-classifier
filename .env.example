# ResumeIQ local environment example.
# Copy this file to .env for local overrides. Do not commit .env.
#
# No API keys are required for the current local features.
# External AI provider keys are future-only and should never be committed.

RESUMEIQ_APP_NAME=ResumeIQ
RESUMEIQ_APP_ENV=local
RESUMEIQ_DEBUG=false
RESUMEIQ_LOG_LEVEL=INFO
RESUMEIQ_API_BASE_URL=http://127.0.0.1:8000
RESUMEIQ_DATABASE_URL=sqlite:///./resumeiq.db
RESUMEIQ_MLFLOW_TRACKING_URI=file:./mlruns
RESUMEIQ_MLFLOW_EXPERIMENT=ResumeIQ Baseline Experiments
RESUMEIQ_MODEL_REGISTRY_PATH=artifacts/model_registry/model_registry.json
RESUMEIQ_PRIVACY_MODE_DEFAULT=false
RESUMEIQ_SAVE_ANALYSIS_DEFAULT=false
RESUMEIQ_STREAMLIT_PORT=8501
RESUMEIQ_API_PORT=8000
RESUMEIQ_DOCKER_MODE=false
