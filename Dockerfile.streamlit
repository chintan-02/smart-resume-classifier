FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV RESUMEIQ_API_BASE_URL=http://api:8000

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .
RUN mkdir -p /app_seed/data \
    && if [ -d data ]; then cp -R data/. /app_seed/data/; fi

EXPOSE 8501

CMD ["sh", "-c", "mkdir -p /app/data && cp -n /app_seed/data/* /app/data/ 2>/dev/null || true; streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.fileWatcherType none"]
